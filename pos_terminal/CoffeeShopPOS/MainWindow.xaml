<Window x:Class="CoffeeShopPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Coffee Shop POS" Height="768" Width="1024" WindowStyle="None" WindowState="Maximized">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,10">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image x:Name="LogoImage" Height="40" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Text="COFFEE SHOP POS" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Separator Width="20" Visibility="Hidden"/>
                    <TextBlock Text="{Binding EmployeeInfoText}" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Admin Panel" Command="{Binding AdminPanelCommand}" Visibility="{Binding AdminPanelButtonVisibility}" Margin="0,0,10,0" Padding="15,5" FontSize="16" FontWeight="SemiBold"/>
                    <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Padding="15,5" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Login Overlay -->
            <Grid Background="#AA000000" Panel.ZIndex="100" Visibility="{Binding LoginGridVisibility}">
                <Border Background="White" Width="400" Height="500" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Margin="40">
                        <TextBlock Text="Enter PIN" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        <PasswordBox x:Name="PinInput" FontSize="48" HorizontalContentAlignment="Center" Margin="0,0,0,20"/>
                        <UniformGrid Columns="3" Rows="4">
                            <Button Content="1" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="1"/>
                            <Button Content="2" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="2"/>
                            <Button Content="3" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="3"/>
                            <Button Content="4" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="4"/>
                            <Button Content="5" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="5"/>
                            <Button Content="6" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="6"/>
                            <Button Content="7" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="7"/>
                            <Button Content="8" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="8"/>
                            <Button Content="9" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="9"/>
                            <Button Content="Clear" Style="{StaticResource PinButtonStyle}" Command="{Binding PinClearCommand}"/>
                            <Button Content="0" Style="{StaticResource PinButtonStyle}" Command="{Binding PinKeyCommand}" CommandParameter="0"/>
                            <Button Content="OK" Style="{StaticResource PinButtonStyle}" Command="{Binding PinOkCommand}" Background="#4CAF50" Foreground="White"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Admin Panel Overlay (Initially Hidden) -->
            <Grid Background="#F5F5F5" Panel.ZIndex="90" Visibility="{Binding AdminPanelGridVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#EEE" Padding="20,10">
                    <Grid>
                        <TextBlock Text="ADMIN PANEL - ARTICLE MARGINS" FontSize="24" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>
                        <Button Content="Back to POS" Command="{Binding CloseAdminPanelCommand}" HorizontalAlignment="Right" Padding="15,5" FontSize="16" Style="{StaticResource POSButtonStyle}"/>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding AdminMargins}" AutoGenerateColumns="False" IsReadOnly="True" Margin="20" FontSize="16" AlternatingRowBackground="#FFF" Background="White" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Article Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="200"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="150"/>
                        <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat={}{0:C}}" Width="150"/>
                        <DataGridTextColumn Header="Profit Margin" Binding="{Binding Profit, StringFormat={}{0:C}}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Main POS Interface (Initially Hidden) -->
            <Grid Visibility="{Binding MainPosGridVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Article Grid grouped by Category -->
                <Grid Grid.Column="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                         <Button Content="1kg Beans" Command="{Binding BeansButtonCommand}" Padding="20,12" Background="{DynamicResource AccentBrush}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,15">
                                        <!-- Category Name Header -->
                                        <TextBlock Text="{Binding CategoryName}" FontSize="22" FontWeight="Bold" Foreground="#3E2723" Margin="5,0,0,10"/>
                                        <!-- Articles Wrapped Grid -->
                                        <ItemsControl ItemsSource="{Binding Articles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="5" Width="180" Height="100" Background="White"
                                                            Command="{Binding DataContext.AddArticleToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource POSButtonStyle}">
                                                        <Grid Margin="5">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding Price, StringFormat={}{0:C}}" FontSize="13" TextAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Right: Cart & Actions -->
                <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="300" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=x{0}}" Margin="10,0" FontSize="14"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:C}}" FontWeight="Bold" FontSize="14"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,10">
                            <Separator/>
                            <Grid Margin="0,10">
                                <TextBlock Text="Total" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2E7D32"/>
                            </Grid>
                        </StackPanel>

                        <UniformGrid Grid.Row="3" Columns="2" Rows="2" Height="120">
                            <Button Content="Clear Cart" Command="{Binding ClearCartCommand}" Margin="5" Style="{StaticResource POSButtonStyle}"/>
                            <Button Content="Close Shift" Command="{Binding CloseShiftCommand}" Margin="5" Style="{StaticResource POSButtonStyle}"/>
                            <Button Grid.ColumnSpan="2" Content="PAY" Command="{Binding PayCommand}" Margin="5" FontSize="24" Background="#4CAF50" Foreground="White" Style="{StaticResource POSButtonStyle}"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Shift Open/Close Dialogs -->
            <Grid Visibility="{Binding ShiftDialogGridVisibility}" Background="#AA000000" Panel.ZIndex="150">
                 <Border Background="White" Width="400" Height="300" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Margin="40">
                        <TextBlock Text="{Binding ShiftDialogTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBox Text="{Binding ShiftCashInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="32" HorizontalContentAlignment="Center" Margin="0,0,0,30"/>
                        <Button Content="Confirm" Command="{Binding ShiftConfirmCommand}" Padding="15" FontSize="20" Background="#4CAF50" Foreground="White" Style="{StaticResource POSButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="PinButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="60"/>
        </Style>
        <Style x:Key="POSButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
</Window>
